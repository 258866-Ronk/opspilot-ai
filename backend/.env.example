# ===== OpsPilot AI 配置示例 =====
# 复制本文件为 .env 后修改。.env 已在 .gitignore 中，不会被提交。

# 应用
APP_NAME=OpsPilot AI
DEBUG=true
API_PREFIX=/api/v1

# 数据库：默认 SQLite（开箱即跑）
DATABASE_URL=sqlite+aiosqlite:///./data/opspilot.db
# 切 PostgreSQL + pgvector 时改成：
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/opspilot

# Redis（可选）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# LLM（可选）：留空则使用内置规则引擎，功能完全可演示
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 用 DeepSeek 的话填：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Embedding：local 用本地哈希向量；model 用真实模型（需额外安装）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# JWT：生产环境务必改成随机长字符串
SECRET_KEY=dev-only-change-this-in-production

# Agent
MAX_TOOL_RETRIES=2
MAX_AGENT_STEPS=15
